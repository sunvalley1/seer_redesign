# Reown (WalletConnect) Project ID for Connect Wallet
# Create a project at https://dashboard.reown.com and paste the ID here
VITE_REOWN_PROJECT_ID=your_project_id_here

# Optional: custom Gnosis RPC URL. If not set, falls back to https://rpc.gnosischain.com
VITE_GNOSIS_RPC_URL=

# Optional: IPFS HTTP gateway for submission images/PDFs. Defaults to https://cdn.kleros.link
VITE_IPFS_GATEWAY=

# Optional: Seer app origin for discussion / SIWE APIs. Defaults to https://app.seer.pm
# VITE_SEER_APP_URL=https://app.seer.pm